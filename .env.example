# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.dkhometech.sn
APP_KEY=                          # php artisan key:generate --show

# --- Frontend (build-time Next.js) ---
NEXT_PUBLIC_SITE_URL=https://dkhometech.sn
NEXT_PUBLIC_API_URL=https://api.dkhometech.sn
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=   # code meta Search Console
# Téléphone / WhatsApp / email / réseaux : Admin → Paramètres (pas via .env)

# --- Base de données ---
DB_DATABASE=dkhometech
DB_USERNAME=dkhometech_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Sécurité / CORS / Sanctum ---
# Domaine partagé obligatoire pour le cookie CSRF entre dkhometech.sn et api.dkhometech.sn
SESSION_DOMAIN=.dkhometech.sn
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=dkhometech.sn,www.dkhometech.sn,api.dkhometech.sn
# Une seule origine ici (pas de virgule). www est géré via CORS_ALLOWED_ORIGINS_EXTRA
CORS_ALLOWED_ORIGIN=https://dkhometech.sn
CORS_ALLOWED_ORIGINS_EXTRA=https://www.dkhometech.sn

# --- Perf cache (file = rapide ; database = plus lent) ---
CACHE_STORE=file

# --- Boot backend ---
RUN_MIGRATIONS=true
RUN_SEED=false                    # true une seule fois pour données démo

# --- Compte admin (utilisé par db:seed) ---
ADMIN_EMAIL=admin@dkhometech.sn
ADMIN_PASSWORD=change-me-fort     # obligatoire en prod (pas "password")

# --- Frontend (OAuth redirect) ---
FRONTEND_URL=https://dkhometech.sn

# --- SMS (log = journal ; infobip = fournisseur actuel) ---
SMS_DRIVER=infobip
# Portail Infobip : Developers > API keys, et le nom d'expéditeur approuvé.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_SENDER=
# Identifiants : portail Orange Developer > application > Credentials (Client ID et Client secret)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Expéditeur technique Sénégal (ne pas modifier sauf indication Orange)
ORANGE_SMS_SENDER=2210000
# Nom affiché, uniquement s'il est approuvé dans Configurer (11 caractères max). Vide = expéditeur par défaut.
ORANGE_SMS_SENDER_NAME=

# --- OAuth Socialite (Google Cloud Console / Meta Developers) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/facebook/callback
# FRONTEND_URL=http://localhost:3000

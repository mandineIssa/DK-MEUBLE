# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.dkmeuble.sn
APP_KEY=                          # php artisan key:generate --show

# --- Frontend (build-time Next.js) ---
NEXT_PUBLIC_SITE_URL=https://dkmeuble.sn
NEXT_PUBLIC_API_URL=https://api.dkmeuble.sn
# Téléphone / WhatsApp / email / réseaux : Admin → Paramètres (pas via .env)

# --- Base de données ---
DB_DATABASE=dkmeuble
DB_USERNAME=dkmeuble_user
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# --- Sécurité / CORS / Sanctum ---
SANCTUM_STATEFUL_DOMAINS=dkmeuble.sn,www.dkmeuble.sn
CORS_ALLOWED_ORIGIN=https://dkmeuble.sn

# --- Boot backend ---
RUN_MIGRATIONS=true
RUN_SEED=false                    # true une seule fois pour données démo

# --- Compte admin (utilisé par db:seed) ---
ADMIN_EMAIL=admin@dkmeuble.sn
ADMIN_PASSWORD=change-me-fort     # obligatoire en prod (pas "password")

# --- Frontend (OAuth redirect) ---
FRONTEND_URL=https://dkmeuble.sn

# --- SMS (log = dev ; twilio = prod) ---
SMS_DRIVER=log
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- OAuth Socialite (Google Cloud Console / Meta Developers) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# FACEBOOK_REDIRECT_URI=http://localhost:8000/api/auth/oauth/facebook/callback
# FRONTEND_URL=http://localhost:3000
